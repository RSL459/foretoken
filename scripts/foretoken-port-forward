#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: Copyright contributors to the Foretoken project

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  foretoken-port-forward --namespace <namespace> --frontend <name> [--local-port <port>]

Waits for a FrontendService to become ready, forwards its Service to localhost,
and reconnects after Pod replacement or transport interruption. Press Ctrl-C to stop.

Options:
  -n, --namespace   Namespace containing the FrontendService.
  -f, --frontend    FrontendService name; its Service has the same name.
  -p, --local-port  Localhost port to listen on (default: 8080).
  -h, --help        Show this help.
EOF
}

is_port() {
  [[ "$1" =~ ^[0-9]+$ ]] && ((10#$1 >= 1 && 10#$1 <= 65535))
}

namespace=""
frontend=""
local_port="8080"
wait_timeout="15m"
retry_delay="2"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--namespace)
      [[ $# -ge 2 ]] || { printf 'missing value for %s\n' "$1" >&2; exit 2; }
      namespace="$2"
      shift 2
      ;;
    -f|--frontend)
      [[ $# -ge 2 ]] || { printf 'missing value for %s\n' "$1" >&2; exit 2; }
      frontend="$2"
      shift 2
      ;;
    -p|--local-port)
      [[ $# -ge 2 ]] || { printf 'missing value for %s\n' "$1" >&2; exit 2; }
      local_port="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

[[ -n "$namespace" ]] || { printf '%s\n' '--namespace is required' >&2; exit 2; }
[[ -n "$frontend" ]] || { printf '%s\n' '--frontend is required' >&2; exit 2; }
is_port "$local_port" || {
  printf '%s\n' '--local-port must be between 1 and 65535' >&2
  exit 2
}
command -v kubectl >/dev/null 2>&1 || {
  printf '%s\n' 'kubectl is required' >&2
  exit 1
}

stopping=0
forward_pid=""

stop() {
  stopping=1
  if [[ -n "$forward_pid" ]]; then
    kill "$forward_pid" 2>/dev/null || true
  fi
}
trap stop INT TERM HUP

while ((stopping == 0)); do
  if ! kubectl --namespace "$namespace" wait \
    --for=condition=Ready \
    --timeout="$wait_timeout" \
    "frontendservice/$frontend"; then
    ((stopping == 1)) && break
    printf 'FrontendService %s/%s is not ready; retrying in %ss\n' "$namespace" "$frontend" "$retry_delay" >&2
    sleep "$retry_delay"
    continue
  fi

  remote_port="$(kubectl --namespace "$namespace" get "service/$frontend" \
    -o 'jsonpath={.spec.ports[?(@.name=="http")].port}' 2>/dev/null || true)"
  if ! is_port "$remote_port"; then
    printf 'Service %s/%s has no valid http port; retrying in %ss\n' "$namespace" "$frontend" "$retry_delay" >&2
    sleep "$retry_delay"
    continue
  fi

  printf 'Forwarding http://127.0.0.1:%s to service/%s:%s in namespace %s\n' \
    "$local_port" "$frontend" "$remote_port" "$namespace"
  kubectl --namespace "$namespace" port-forward \
    --address=127.0.0.1 \
    "service/$frontend" \
    "$local_port:$remote_port" &
  forward_pid=$!
  if wait "$forward_pid"; then
    forward_status=0
  else
    forward_status=$?
  fi
  forward_pid=""

  ((stopping == 1)) && break
  printf 'Port-forward exited with status %s; reconnecting in %ss\n' "$forward_status" "$retry_delay" >&2
  sleep "$retry_delay"
done
