+    def get_scheduler_load(self) -> dict[str, int] | None:
+        """Return token demand for capacity planning; activate capture on first query.
+
+        Unsupported layouts and active engines awaiting their first captured
+        scheduling step return None rather than an approximate load.
+        """
+        groups = self.kv_cache_config.kv_cache_groups
+        if (
+            len(groups) != 1
+            or not isinstance(groups[0].kv_cache_spec, FullAttentionSpec)
+            or self.dcp_world_size != 1
+            or self.pcp_world_size != 1
+        ):
+            return None
+        self._capture_scheduler_load = True
+        if self.running and self._scheduled_decode_load is None:
+            return None
+        queued_prefill = queued_decode = 0
+        for queue in (self.waiting, self.skipped_waiting):
+            for request in queue:
+                if request.status in (
+                    RequestStatus.PREEMPTED,
+                    RequestStatus.WAITING_FOR_REMOTE_KVS,
+                ):
+                    queued_decode += request.num_computed_tokens
+                else:
+                    queued_prefill += request.num_tokens
+        scheduled_decode = sum(
+            tokens
+            for request_id, tokens in (self._scheduled_decode_load or {}).items()
+            if request_id in self.requests
+        )
+        return {
+            "data_parallel_rank": self.parallel_config.data_parallel_index,
+            "queued_prefill_tokens": queued_prefill,
+            "scheduled_decode_kv_tokens": scheduled_decode,
+            "queued_decode_kv_tokens": queued_decode,
+            "context_length": self.max_model_len,
+            "kv_capacity_tokens": self.kv_cache_config.num_blocks
+            * groups[0].kv_cache_spec.block_size,
+        }
+
